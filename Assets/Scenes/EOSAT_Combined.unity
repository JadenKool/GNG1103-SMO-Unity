  m_Script: {fileID: 11500000, guid: 4e8298482bf8a8549b82716352079e63, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Eosat.Meta.ControllerAnnotationGuide
  controller: {fileID: 856707017}
  head: {fileID: 856707014}
  showBelowPitch: 40
  hideAbovePitch: 25
  fadeSeconds: 0.25
  lift: 0.1
  towardEyes: 0.04
  guideText: {fileID: 2050484527}
  mrGuide: '<b>MR CONTROLS</b>

    <color=#4DC8FF>GRIP</color>  grab the globe to spin it

    <color=#4DC8FF>TRIGGER</color>  point at a grab bar, then push / pull

    <color=#4DC8FF>A  /  X</color>  recentre the layout

    <color=#4DC8FF>B  /  Y</color>  switch MR tabletop / VR orbit'
  vrGuide: "<b>VR CONTROLS</b>\n<color=#4DC8FF>RIGHT STICK</color>  orbit the target - full 360\xB0\n<color=#4DC8FF>LEFT STICK</color>  up / down = zoom\n<color=#4DC8FF>A  /  X</color>  recentre on the target\n<color=#4DC8FF>B  /  Y</color>  switch MR tabletop / VR orbit\n<color=#4DC8FF>LEFT WRIST</color>  iPad: telemetry, deploy, connections"
